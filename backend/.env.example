# Copy this file to .env and replace the placeholder values. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origin allowed by CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection for the app's own role (created by `npm run db:create`)
DATABASE_URL="postgresql://forms_app:change-me@localhost:5432/forms_db?schema=public"

# Optional: public URL the keep-alive job pings every 14 minutes. On Render it defaults to
# RENDER_EXTERNAL_URL, which Render sets.
# Leave it unset locally.
# KEEP_ALIVE_URL=

# Optional: logins created by `npm run db:seed` (defaults shown; local development only)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_AGENT_PASSWORD=Agent@12345

# Authentication
# Generate a long random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
